{
  "name": "fleetpulse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "build": "npm run build --workspace=@fleetpulse/database && npm run build --workspace=@fleetpulse/api",
    "db:generate": "npm run generate --workspace=@fleetpulse/database",
    "db:migrate": "npm run migrate --workspace=@fleetpulse/database",
    "db:migrate:dev": "npm run migrate:dev --workspace=@fleetpulse/database",
    "db:seed": "npm run seed --workspace=@fleetpulse/database",
    "db:studio": "npm run studio --workspace=@fleetpulse/database",
    "db:reset": "npm run reset --workspace=@fleetpulse/database",
    "dev": "npm run dev --workspace=@fleetpulse/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
