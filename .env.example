`NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://fleetpulse:fleetpulse@localhost:55432/fleetpulse
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=vehicle.telemetry.v1
KAFKA_CLIENT_ID=fleetpulse-simulator
KAFKA_GROUP_ID=fleetpulse-ingestion
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000
KAFKA_FROM_BEGINNING=false
IDEMPOTENCY_TTL_SECONDS=604800
STREAM_PROCESSOR_GROUP=fleetpulse-stream-processor
MAX_OUT_OF_ORDER_MS=30000
ENGINE_TEMP_THRESHOLD_C=110
ENGINE_TEMP_WINDOW_SECONDS=30
RAPID_TEMP_RISE_THRESHOLD=0.5
HARSH_BRAKING_THRESHOLD=25
IDLE_THRESHOLD_SECONDS=300
LOW_BATTERY_THRESHOLD_PERCENT=20
LOW_BATTERY_SOH_THRESHOLD_PERCENT=70
ALERT_COOLDOWN_SECONDS=300
STATE_TTL_SECONDS=900
ALERT_RESOLUTION_NORMAL_EVENTS=3
VEHICLE_LOOKUP_BATCH_SIZE=250
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=fleetpulse
CLICKHOUSE_USER=fleetpulse
CLICKHOUSE_PASSWORD=fleetpulse
ML_SERVICE_URL=http://localhost:8000
AUTH_MODE=disabled
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_PER_MINUTE=120
HISTORICAL_ANALYTICS_GROUP=fleetpulse-historical-analytics
