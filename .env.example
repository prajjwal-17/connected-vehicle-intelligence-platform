NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://fleetpulse:fleetpulse@localhost:55432/fleetpulse
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=vehicle.telemetry.v1
KAFKA_CLIENT_ID=fleetpulse-simulator
KAFKA_GROUP_ID=fleetpulse-ingestion
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000
KAFKA_FROM_BEGINNING=false
IDEMPOTENCY_TTL_SECONDS=604800
